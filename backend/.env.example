# backend/.env.example
# Copy this file to .env and fill in the values.

# Flask
FLASK_DEBUG=1
FLASK_SECRET_KEY=replace-with-a-random-secret

# Supabase PostgreSQL connection (use the Supabase pooler URL)
# Example: postgresql+pg8000://username:password@host:5432/database
# Optional database URL. Defaults to SQLite in the Flask instance directory.
# For PostgreSQL, use the Supabase pooler URL:
# DATABASE_URL=postgresql+pg8000://<username>:<password>@<host>:5432/<database>

# JWT
JWT_SECRET_KEY=replace-with-a-random-secret

# CORS (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
